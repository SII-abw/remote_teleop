[Unit]
Description=Siinuc remote teleoperation gateway
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/siinuc2/Evo-RL/remote_teleop
ExecStart=/bin/bash /home/siinuc2/Evo-RL/remote_teleop/scripts/run.sh cloud
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

[Install]
WantedBy=default.target
